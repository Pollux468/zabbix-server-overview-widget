{
	"manifest_version": 2.0,
	"id": "serveroverview",
	"type": "widget",
	"name": "Server: Vista general",
	"namespace": "ServerOverview",
	"version": "1.0",
	"author": "Roberto Columna",
	"description": "Vista consolidada de servidores standalone (Linux/Windows) monitoreados por Zabbix Agent. CPU, RAM, discos, red, uptime, inventario.",
	"url": "https://www.zabbix.com/integrations/os-linux",
	"widget": {
		"js_class": "CWidgetServerOverview",
		"size": {
			"width": 72,
			"height": 12
		},
		"refresh_rate": 60,
		"in": {
			"groupids": {
				"type": "_hostgroupids"
			}
		},
		"out": [
			{
				"type": "_hostid"
			},
			{
				"type": "_hostids"
			}
		]
	},
	"actions": {
		"widget.serveroverview.view": {
			"class": "WidgetView"
		},
		"widget.serveroverview.disk.get": {
			"class": "DiskDetails",
			"layout": "layout.json"
		},
		"widget.serveroverview.server.get": {
			"class": "ServerDetails",
			"layout": "layout.json"
		},
		"widget.serveroverview.diagnostic.run": {
			"class": "Diagnostics",
			"layout": "layout.json"
		}
	},
	"assets": {
		"js": ["class.widget.js"],
		"css": ["widget.css"]
	}
}
